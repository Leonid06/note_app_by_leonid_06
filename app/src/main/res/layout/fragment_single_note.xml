<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.notes_feature.fragments.SingleNoteFragment"
        android:background="@color/note_background_color_3"
        >

        <ImageButton
            android:background="@drawable/ic_cancel"
            android:id="@+id/ivCancel"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

        </ImageButton>

        <ImageButton
            android:background="@drawable/ic_folders_stack"
            android:id="@+id/ivFolderChange"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivBackup"
            />

        <ImageButton
            android:background="@drawable/ic_backup"
            android:id="@+id/ivBackup"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

        </ImageButton>

        <ScrollView
            style="@style/FixedScrollViewTheme"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:fadingEdgeLength="40dp"
            android:fadingEdge="horizontal"
            android:focusable="true"
            android:layout_marginBottom="20dp"
            android:requiresFadingEdge="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivCancel">


            <EditText
                android:id="@+id/etNoteContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:isScrollContainer="true"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="25sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent" />


        </ScrollView>




    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
