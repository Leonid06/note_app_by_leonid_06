<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.notes_feature.fragments.SingleNoteFragment"
        android:background="@color/note_background_color_3"
        >

        <ImageButton
            android:background="@drawable/ic_cancel"
            android:id="@+id/ivCancel"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

        </ImageButton>

        <ImageButton
            android:background="@drawable/ic_folders_stack"
            android:id="@+id/ivFolderChange"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivBackup"
            />

        <ImageButton
            android:background="@drawable/ic_backup"
            android:id="@+id/ivBackup"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

        </ImageButton>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="575dp"
            android:requiresFadingEdge="horizontal"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/ivCancel"
            android:focusable="true"
            style="@style/FixedScrollViewTheme"
            >

            <LinearLayout
                android:id="@+id/noteGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <EditText
                    android:id="@+id/etNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:background="@null"
                    android:isScrollContainer="true"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textSize="25sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="parent" />

            </LinearLayout>

        </ScrollView>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:backgroundTint="@color/button_color_1"
            android:id="@+id/add_note_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_check"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
