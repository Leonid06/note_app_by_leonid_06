<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_background_color_3"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.folders_feature.FoldersFragment">

    <TextView
        android:id="@+id/tvFolderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:text="@string/folders_title"
        android:textColor="@color/button_color_2"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/foldersRecyclerView"
        android:layout_width="380dp"
        android:layout_height="550dp"
        android:layout_marginTop="25dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFolderTitle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:foregroundGravity="left"
        android:layout_margin="16dp"
        android:id="@+id/add_folder_button"
        android:backgroundTint="@color/button_color_1"
        android:src="@drawable/ic_add_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>