<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.example.leonidsnotesapplication.presentation.folders_feature.viewmodels.FoldersViewModel" />

        <variable
            name="adapter"
            type="com.example.leonidsnotesapplication.presentation.folders_feature.FoldersAdapter" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/note_background_color_3"
        tools:context=".presentation.folders_feature.fragments.FoldersFragment">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/folderSearchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:theme="@style/AppSearchView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/etFolderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="@string/folders_title"
            android:textColor="@color/button_color_2"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/folderSearchView" />

        <ImageButton
            android:id="@+id/ibSort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ic_sort"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/folderSearchView"
            tools:ignore="MissingConstraints"/>

        <androidx.recyclerview.widget.RecyclerView
            tools:listitem="@layout/folder_card_view"
            android:id="@+id/foldersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="535dp"
            android:layout_marginTop="15dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideInset"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFolderTitle"
            app:setFolderAdapter = "@{adapter}"
            app:submitFolderList = "@{viewModel.foldersLiveData}"
            />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:foregroundGravity="left"
            android:layout_margin="16dp"
            android:id="@+id/add_folder_button"
            android:backgroundTint="@color/button_color_1"
            android:src="@drawable/ic_add_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:foregroundGravity="left"
            android:layout_margin="16dp"
            android:id="@+id/home_button"
            android:backgroundTint="@color/button_color_1"
            android:src="@drawable/ic_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>


