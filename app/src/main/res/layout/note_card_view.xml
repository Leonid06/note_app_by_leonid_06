<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="14dp"
    android:layout_margin="8dp"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/default_card_color">

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="350dp"
            android:layout_height="50dp"
            android:layout_margin="4dp"
            android:padding="10dp"
            android:singleLine="true"
            android:textAlignment="textStart"
            android:textColor="@color/font_color_1"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Title" />

        <TextView
            android:id="@+id/tvNoteSubtitle"
            android:layout_width="167dp"
            android:layout_height="19dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:textColor="@color/font_color_2"
            app:layout_constraintStart_toEndOf="@id/tvNoteDatetime"
            app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
            tools:text="No additional information" />


        <TextView
            android:id="@+id/tvNoteDatetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="15dp"
            android:textColor="@color/font_color_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
            tools:text="31 Jun 2008 11:05:30" />

        <ImageButton
            android:id="@+id/ibDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNoteTitle"/>



        <CheckBox
            android:id="@+id/cbStar"
            android:button="@drawable/star_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop = "10dp"
            android:layout_marginStart="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvNoteTitle"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>