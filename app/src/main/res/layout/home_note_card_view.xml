<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewData"
            type="com.leonid.leonidsnotesapplication.domain.model.NoteViewData" />

    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:fitsSystemWindows="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/note_card_view_style_2">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="350dp"
                android:layout_height="25dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:singleLine="true"
                android:textAlignment="textStart"
                android:textColor="@color/font_color_1"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@{viewData.title}"
                tools:text="Title" />


            <ImageView
                android:id="@+id/ivFolder"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/ic_card_folder"
                setFolderVisibility="@{viewData.defaultFolder}"
                app:layout_constraintStart_toEndOf="@id/tvNoteDatetime"
                app:layout_constraintTop_toBottomOf="@id/tvNoteTitle" />

            <TextView
                android:id="@+id/tvNoteSubtitle"
                android:layout_width="167dp"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/font_color_2"
                app:layout_constraintStart_toEndOf="@id/ivFolder"
                app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
                tools:text="Folder title" />



            <TextView
                android:id="@+id/tvNoteDatetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/font_color_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
                tools:text="31 Jun 2008 11:05:30"
                android:text="@{viewData.folderTitle}"/>


            <ImageButton
                android:id="@+id/ibDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_delete"
                android:layout_marginStart="13dp"
                app:layout_constraintStart_toEndOf="@+id/tvNoteTitle"
                app:layout_constraintTop_toBottomOf="@+id/cbStar" />

            <CheckBox
                android:id="@+id/cbStar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:checked="@{viewData.isStarred}"
                android:button="@drawable/star_button"
                app:layout_constraintStart_toEndOf="@id/tvNoteTitle"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>