<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.example.leonidsnotesapplication.presentation.notes_feature.fragments.NotesFragment"
        android:label="fragment_notes"
        tools:layout="@layout/fragment_notes"
        >

        <action
            android:id="@+id/action_notesFragment_to_singleNoteFragment"
            app:destination="@id/singleNoteFragment"
            app:popUpTo="@id/notesFragment"/>

        <action
            android:id="@+id/action_notesFragment_to_foldersFragment"
            app:destination="@id/foldersFragment" />
        <action
            android:id="@+id/action_notesFragment_to_noteDeleteDialogFragment"
            app:destination="@id/NoteDeleteDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/singleNoteFragment"
        android:name="com.example.leonidsnotesapplication.presentation.notes_feature.fragments.SingleNoteFragment"
        android:label="fragment_single_note"
        tools:layout="@layout/fragment_single_note" >
        <argument
            android:name="isNew"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/foldersFragment"
        android:name="com.example.leonidsnotesapplication.presentation.folders_feature.fragments.FoldersFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_folders" >
        <action
            android:id="@+id/action_foldersFragment_to_folderAddDialog"
            app:destination="@id/folderAddDialog" />
        <action
            android:id="@+id/action_foldersFragment_to_notesFragment"
            app:destination="@id/notesFragment" />
        <action
            android:id="@+id/action_foldersFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <dialog
        android:id="@+id/folderAddDialog"
        android:name="com.example.leonidsnotesapplication.presentation.folders_feature.fragments.FolderAddDialogFragment"
        android:label="FolderAddDialog" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.leonidsnotesapplication.presentation.notes_feature.fragments.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_singleNoteFragment"
            app:destination="@id/singleNoteFragment" />
        <action
            android:id="@+id/action_homeFragment_to_foldersFragment"
            app:destination="@id/foldersFragment" />
        <action
            android:id="@+id/action_homeFragment_to_homeDeleteDialogFragment"
            app:destination="@id/homeDeleteDialogFragment" />
    </fragment>
    <dialog
        android:id="@+id/NoteDeleteDialogFragment"
        android:name="com.example.leonidsnotesapplication.presentation.notes_feature.fragments.NotesDeleteDialogFragment"
        android:label="noteDeleteDialogFragment"/>
    <dialog
        android:id="@+id/homeDeleteDialogFragment"
        android:name="com.example.leonidsnotesapplication.presentation.notes_feature.fragments.HomeDeleteDialogFragment"
        android:label="HomeDeleteDialogFragment" />
</navigation>